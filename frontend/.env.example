# ========================================
# Smart Samarpan Academy - Frontend .env
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Google OAuth Client ID (same as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay public key (same as backend Razorpay_Key)
VITE_RAZORPAY_KEY=rzp_test_your_key_here

# Backend server URL
# Local development: http://localhost:5175
# Production (Render): https://your-backend-service.onrender.com
VITE_SERVER=http://localhost:5175
