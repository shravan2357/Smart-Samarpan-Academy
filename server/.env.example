# =======================================
# Smart Samarpan Academy - Backend .env
# =======================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=5175

# MongoDB Atlas connection string
DB=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/samarpan

# JWT Secrets (use long random strings)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=15d

# Account activation & password reset secrets
Activation_Secret=your_activation_secret_here
Forgot_Secret=your_forgot_secret_here

# Email - Gmail (local dev only)
Gmail=your_gmail_address@gmail.com
Password=your_gmail_app_password

# Email - Brevo SMTP (recommended for Render/production)
BREVO_USER=your_brevo_smtp_username
BREVO_PASS=your_brevo_smtp_password

# Razorpay Payment Gateway
Razorpay_Key=rzp_test_your_key_here
Razorpay_Secret=your_razorpay_secret_here

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Frontend URL (local: http://localhost:5173 | production: your Render/Vercel URL)
frontendurl=http://localhost:5173

# Admin seeding (used only by scripts/createAdmin.js - NOT used at runtime)
ADMIN_EMAIL=your_admin_email@gmail.com
ADMIN_PASSWORD=your_admin_password
